# ── Dense 임베딩 (DeepInfra API) ───────────────────────────────────────────────
# DeepInfra API 키 — https://deepinfra.com
# 없으면 Dense 인덱스 빌드·검색이 스킵되고 BM25만 사용됩니다.
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ── 법제처 API 키 ──────────────────────────────────────────────────────────────
# 유저가 각자의 키를 MCP URL 파라미터로 전달하는 방식을 권장합니다:
#   https://your-server.com/mcp?law_oc=USER_KEY
#
# 서버 공용 기본값이 있다면 여기에 설정하세요 (없으면 비워둠).
LAW_OC_DEFAULT=

# ── MCP 서버 인증 ──────────────────────────────────────────────────────────────
# 공개 인터넷 배포 시 필수. 비워두면 인증 없이 누구나 접근 가능합니다.
MCP_API_KEY=your_mcp_api_key_here

# ── PDF 변환 (docling) ─────────────────────────────────────────────────────────
# mps: Apple Silicon GPU (M1/M2/M3)
# cuda: NVIDIA GPU
# cpu: CPU 전용 (느림)
TORCH_DEVICE=mps

# ── LH 규정 크롤링 ─────────────────────────────────────────────────────────────
LH_REGULATIONS_URL=https://www.lh.or.kr/board.es?mid=a10108020000&bid=0055
LH_RSS_URL=https://www.lh.or.kr/rss/board.es?mid=a10108020000&bid=0055

# ── 데이터 경로 ────────────────────────────────────────────────────────────────
BM25_PATH=./data/lh_regulation
MARKDOWN_PATH=./data/lh_regulation/markdown
KCSC_DATA_PATH=./data/kcsc
# 조달청 해석사례 (법제처 OPEN API ppsCgmExpc — 인증키는 LAW_OC_DEFAULT 재사용)
PPS_DATA_PATH=./data/pps

# ── KCSC 건설기준 (국가건설기준센터 Open API) ──────────────────────────────────
# https://www.kcsc.re.kr 에서 API 키 발급
KCSC_API_KEY=your_kcsc_api_key_here
KCSC_API_BASE=https://kcsc.re.kr/OpenApi

# ── 서버 ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
