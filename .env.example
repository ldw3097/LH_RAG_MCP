# ── LLM 라우터 ────────────────────────────────────────────────────────────────
# OpenAI 호환 엔드포인트라면 어디든 사용 가능합니다.
#
# DeepInfra (기본값)
ROUTER_BASE_URL=https://api.deepinfra.com/v1/openai
ROUTER_API_KEY=your_deepinfra_api_key_here
ROUTER_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# OpenAI로 전환하려면:
# ROUTER_BASE_URL=https://api.openai.com/v1
# ROUTER_API_KEY=sk-...
# ROUTER_MODEL=gpt-4o-mini
#
# 로컬 Ollama로 전환하려면:
# ROUTER_BASE_URL=http://localhost:11434/v1
# ROUTER_API_KEY=ollama
# ROUTER_MODEL=qwen2.5:7b

# ── 법제처 API 키 ──────────────────────────────────────────────────────────────
# 유저가 각자의 키를 MCP URL 파라미터로 전달하는 방식을 권장합니다:
#   https://your-server.com/mcp?law_oc=USER_KEY
#
# 서버 공용 기본값이 있다면 여기에 설정하세요 (없으면 비워둠).
LAW_OC_DEFAULT=

# ── MCP 서버 인증 ──────────────────────────────────────────────────────────────
# 공개 인터넷 배포 시 필수. 비워두면 인증 없이 누구나 접근 가능합니다.
MCP_API_KEY=your_mcp_api_key_here

# ── PDF 변환 (marker) ──────────────────────────────────────────────────────────
# mps: Apple Silicon GPU (M1/M2/M3)
# cuda: NVIDIA GPU
# cpu: CPU 전용 (느림)
TORCH_DEVICE=mps

# ── 임베딩 및 벡터DB ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=lh_regulations

# ── LH 규정 크롤링 ─────────────────────────────────────────────────────────────
LH_REGULATIONS_URL=https://www.lh.or.kr/menu.es?mid=a10106070000
LH_RSS_URL=https://www.lh.or.kr/rss/board.es?mid=a10108020000&bid=0055

# ── 서버 ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
